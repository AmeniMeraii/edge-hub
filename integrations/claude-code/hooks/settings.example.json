{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://localhost:5080/hooks/claude/permission",
            "timeout": 75,
            "headers": { "Authorization": "Bearer <hook token from --new-hook-token>" }
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://localhost:5080/hooks/claude/notification",
            "timeout": 5,
            "headers": { "Authorization": "Bearer <hook token from --new-hook-token>" }
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://localhost:5080/hooks/claude/stop",
            "timeout": 5,
            "headers": { "Authorization": "Bearer <hook token from --new-hook-token>" }
          }
        ]
      }
    ]
  }
}
