{
  // Copy this file to appsettings.Local.json (ignored by git) and fill in your own values,
  // or use dotnet user-secrets during development. Never commit a real token.
  "Server": {
    // Port the service listens on.
    "Port": 5080,
    // false: only this PC can reach the service.
    // true: the tablet can reach it too. That also needs a Windows Firewall rule for this port, Private profile only.
    "ListenOnNetwork": false
  },
  "Security": {
    // A long random token: 32 characters or more, only letters, digits, - and _ (see the README for a generator).
    // The tablet opens http://<PC address>:5080/?k=<token> once: the token then moves into a cookie and the address
    // is cleaned. A published service reads this file next to EdgeHub.exe.
    "Token": ""
  },
  "Logs": {
    // Folder of the daily log files. It may name environment variables; empty: no log file.
    "Folder": "%LOCALAPPDATA%\\EdgeHub\\logs",
    // Days of logs kept, 1 to 365: older files are deleted.
    "RetainedDays": 14
  },
  "Calendar": {
    // The calendar's secret iCal address (Google Calendar: Settings and sharing, Integrate calendar, secret address
    // in iCal format). It gives read access to the whole calendar: keep it out of git, logs and screenshots.
    // Leave it empty and the screen keeps the manual choice of session.
    "IcalUrl": "",
    // The time zone "today" and every time are read in.
    "TimeZone": "Europe/Paris",
    // Optional: how a title names a session. A list you give replaces that whole list; a list you leave out keeps
    // the defaults below. A keyword matches a whole word, whatever the case; ending it with * makes it match the start
    // of a word too ("footing*" matches "Footings"). Emojis match anywhere.
    "Sport": {
      "Kinds": [
        { "Name": "Course", "Keywords": [ "🏃", "course", "footing*", "run" ] },
        { "Name": "Muscu", "Keywords": [ "💪", "muscu*", "full body*", "salle" ] },
        { "Name": "Marche", "Keywords": [ "🚶", "marche" ] }
      ],
      // A title that starts with one of these is a cancelled session.
      "CancelledMarkers": [ "❌" ],
      // A title that contains one of these, whatever the case, is a cancelled session.
      "CancelledWords": [ "annul" ]
    }
  }
}
