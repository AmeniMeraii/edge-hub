<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Windows TFM: needed for the Windows media controls (Spotify, Windows.Media.Control). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- LibraryImport (CPU times, memory status) generates its interop code as unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Development secrets (the access token) live in the user profile, outside the repository. -->
    <UserSecretsId>edgehub-service</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ical.Net" Version="5.2.4" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
